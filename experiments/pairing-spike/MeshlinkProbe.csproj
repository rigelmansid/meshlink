<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 0 spike for D-20; not shipped. Build: dotnet build -c Release -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same RhinoCommon as rhinomcp 0.4.1.1, so it loads wherever rhinomcp does. -->
    <PackageReference Include="RhinoCommon" Version="8.17.25066.7001" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
